# Firebase Configuration
# Copy this file to .env and fill in your Firebase project details

VITE_FIREBASE_API_KEY="your-api-key-here"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="your-measurement-id"

# Optional: Admin WhatsApp number for merch inquiries
VITE_ADMIN_WHATSAPP="26774421107"

# Payment Gateway Configuration (Flutterwave)
# Get these from your Flutterwave dashboard
# Flutterwave supports Botswana and local payment methods
VITE_FLUTTERWAVE_PUBLIC_KEY="your-flutterwave-public-key"
VITE_FLUTTERWAVE_SANDBOX="true"

# Email Service Configuration (EmailJS)
# Get these from your EmailJS dashboard at https://www.emailjs.com/
# Used for sending donation confirmation and status update emails
NEXT_PUBLIC_EMAILJS_SERVICE_ID="your-emailjs-service-id"
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID="your-emailjs-template-id"
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY="your-emailjs-public-key"

# Admin Email Configuration
# Comma-separated list of admin emails that receive donation notifications
VITE_ADMIN_NOTIFICATION_EMAILS="admin@pioneer-ventures-society.org,finance@pioneer-ventures-society.org"
VITE_PRIMARY_ADMIN_EMAIL="admin@pioneer-ventures-society.org"
VITE_FINANCE_EMAIL="finance@pioneer-ventures-society.org"